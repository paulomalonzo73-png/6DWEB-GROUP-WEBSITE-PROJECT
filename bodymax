<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>BODY MAXXING | Precision Planner</title>

<style>
:root { --primary:#e63946; --accent:#4cc9f0; --dark:#161b22; }
body { font-family:'Inter',sans-serif; background:#0d1117; color:#c9d1d9; margin:0; padding:20px; }
.container { max-width:900px; margin:auto; background:var(--dark); padding:30px; border-radius:12px; border:1px solid #30363d; }
h1 { color:white; text-align:center; font-size:2rem; letter-spacing:2px; margin-top:0; }
span.red { color:var(--primary); }

input, select, button {
width:100%;
padding:12px;
margin-bottom:15px;
border-radius:6px;
border:1px solid #30363d;
background:#0d1117;
color:white;
box-sizing:border-box;
}

button { background:var(--primary); color:white; border:none; font-weight:800; cursor:pointer; transition:0.3s; }
button:hover { background:#ff4d5a; }

.hidden { display:none; }

.form-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:15px; margin-bottom:20px; }
label { display:block; margin-bottom:5px; font-size:0.85rem; color:#8b949e; }

#result { margin-top:30px; }
.section-title { border-bottom:2px solid var(--primary); padding-bottom:5px; margin-top:25px; color:white; }

.macro-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:10px; margin-top:15px; }
.macro-card { background:#21262d; padding:15px; border-radius:8px; text-align:center; }
.macro-val { display:block; font-size:1.5rem; font-weight:bold; color:var(--accent); }

.workout-day { background:#21262d; padding:15px; border-radius:8px; margin-bottom:10px; }
.exercise-list { color:#8b949e; font-size:0.9rem; margin-top:5px; }
.muscle-group { color:var(--primary); font-weight:bold; }

.toggle-link { color:var(--accent); cursor:pointer; font-size:0.9rem; text-decoration:underline; }
/* Password eye toggle */
.pw-wrap { position:relative; }
.pw-wrap input { padding-right:44px; }
.pw-toggle {
position:absolute;
right:10px;
top:50%;
transform:translateY(-50%);
height:32px;
width:32px;
border-radius:8px;
border:1px solid #30363d;
background:#161b22;
cursor:pointer;
display:flex;
align-items:center;
justify-content:center;
padding:0;
}
.pw-toggle:hover { border-color:#3d444d; }
.pw-toggle svg { width:18px; height:18px; fill:#c9d1d9; }
.pw-toggle[aria-pressed="true"] svg { fill:var(--accent); }

/* Small helper text */
.helper { color:#8b949e; font-size:0.85rem; margin-top:-10px; margin-bottom:15px; }
</style>
</head>

<body>

<div class="container" id="login-container">
<h1>BODY<span class="red">MAXXING</span> LOGIN</h1>

<div id="login-form">
<input type="text" id="login-user" placeholder="Username" autocomplete="username" />

<div class="pw-wrap">
<input type="password" id="login-pass" placeholder="Password" autocomplete="current-password" />
<button class="pw-toggle" type="button" aria-label="Show password" aria-pressed="false" onclick="togglePassword('login-pass', this)">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
</svg>
</button>
</div>

<button onclick="login()">Login</button>
<p class="toggle-link" onclick="toggleForm()">Don't have an account? Sign Up</p>
</div>

<div id="signup-form" class="hidden">
<input type="text" id="signup-user" placeholder="Choose a Username" autocomplete="username" />

<div class="pw-wrap">
<input type="password" id="signup-pass" placeholder="Choose a Password" autocomplete="new-password" />
<button class="pw-toggle" type="button" aria-label="Show password" aria-pressed="false" onclick="togglePassword('signup-pass', this)">
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
</svg>
</button>
</div>

<button onclick="signup()">Create Account</button>
<p class="toggle-link" onclick="toggleForm()">Already have an account? Login</p>
</div>
</div>

<div class="container hidden" id="planner-container">
<h1>BODY<span class="red">MAXXING</span> AUTOMATION</h1>

<div class="form-grid">
<div>
<label>Workout Type</label>
<select id="workoutType">
<option value="gym">Gym Workout</option>
<option value="home">Home Workout</option>
</select>
</div>

<div>
<label>Gender</label>
<select id="gender">
<option value="male">Male</option>
<option value="female">Female</option>
</select>
</div>

<div>
<label>Age</label>
<input type="number" id="age" value="25" min="10" max="99" />
</div>

<div>
<label>Weight (kg)</label>
<input type="number" id="weight" value="75" min="20" max="250" step="0.1" />
</div>

<div>
<label>Height</label>
<div style="display:flex; gap:10px;">
<input type="number" id="height" value="180" min="40" max="250" step="0.1" style="margin-bottom:15px;" />
<select id="heightUnit" style="max-width:110px;">
<option value="cm">CM</option>
<option value="in">IN</option>
</select>
</div>
<div class="helper">IN will be converted to CM automatically.</div>
</div>

<div>
<label>Experience</label>
<select id="exp">
<option value="beginner">Beginner</option>
<option value="intermediate">Intermediate</option>
<option value="expert">Expert</option>
</select>
</div>

<div>
<label>Goal</label>
<select id="goal">
<option value="bulking">Bulking</option>
<option value="cutting">Cutting</option>
<option value="endurance">Endurance</option>
<option value="general">General Fitness</option>
</select>
</div>

<div>
<label>Metabolism</label>
<select id="metabolism">
<option value="moderate" selected>Moderate</option>
<option value="fast">Fast</option>
<option value="slow">Slow</option>
</select>
</div>
</div>

<button onclick="generateAll()">GENERATE BODY MAXXING PLAN</button>

<div id="result">
<h2 class="section-title">DAILY NUTRITION TARGETS</h2>
<div class="macro-grid">
<div class="macro-card"><span class="macro-val" id="res-cal">0</span>Calories</div>
<div class="macro-card"><span class="macro-val" id="res-pro">0</span>Protein (g)</div>
<div class="macro-card"><span class="macro-val" id="res-carb">0</span>Carbs (g)</div>
<div class="macro-card"><span class="macro-val" id="res-fat">0</span>Fats (g)</div>
</div>

<h2 class="section-title">WORKOUT SCHEDULE (<span id="plan-type"></span>)</h2>
<div id="workout-list"></div>
</div>
</div>

<script>
// Simple client-side storage for demo purposes
let users = {}; // {username: password}

function toggleForm() {
document.getElementById('login-form').classList.toggle('hidden');
document.getElementById('signup-form').classList.toggle('hidden');
}

function togglePassword(inputId, btn) {
const input = document.getElementById(inputId);
const isHidden = input.type === "password";
input.type = isHidden ? "text" : "password";
btn.setAttribute("aria-pressed", String(isHidden));
btn.setAttribute("aria-label", isHidden ? "Hide password" : "Show password");
}

// Sign Up
function signup() {
const username = document.getElementById('signup-user').value.trim();
const password = document.getElementById('signup-pass').value.trim();
if(!username || !password) { alert("Please fill all fields."); return; }
if(users[username]) { alert("Username already exists."); return; }
users[username] = password;
alert("Account created! You can now login.");
toggleForm();
}

// Login
function login() {
const username = document.getElementById('login-user').value.trim();
const password = document.getElementById('login-pass').value.trim();
if(users[username] && users[username] === password) {
alert("Login successful!");
document.getElementById('login-container').classList.add('hidden');
document.getElementById('planner-container').classList.remove('hidden');
} else {
alert("Invalid username or password.");
}
}

function heightToCm(value, unit) {
const h = parseFloat(value);
if (!isFinite(h) || h <= 0) return NaN;
return unit === "in" ? (h * 2.54) : h;
}

// Workout & Nutrition
function generateAll() {
const workoutType = document.getElementById('workoutType').value; // gym/home
const w = parseFloat(document.getElementById('weight').value);
const a = parseInt(document.getElementById('age').value, 10);
const g = document.getElementById('gender').value;
const goal = document.getElementById('goal').value; // bulking/cutting/endurance/general
const exp = document.getElementById('exp').value; // beginner/intermediate/expert

const hUnit = document.getElementById('heightUnit').value;
const hRaw = document.getElementById('height').value;
const hCm = heightToCm(hRaw, hUnit);

const metabolism = document.getElementById('metabolism').value;

if(!isFinite(w) || w <= 0 || !isFinite(a) || a <= 0 || !isFinite(hCm) || hCm <= 0) {
alert("Please enter valid Age, Weight, and Height.");
return;
}

// BMR (Mifflin-St Jeor)
let bmr = (10 * w) + (6.25 * hCm) - (5 * a) + (g === "male" ? 5 : -161);
let maintenance = bmr * 1.55;

// Metabolism-based adjustment for calorie + macro aggressiveness
const meta = {
fast: { gain: 1.15, cut: 0.90, pro: 2.3, fat: 1.0 },
moderate: { gain: 1.10, cut: 0.88, pro: 2.2, fat: 0.9 },
slow: { gain: 1.05, cut: 0.93, pro: 2.0, fat: 0.8 }
};
const cfg = meta[metabolism] || meta.moderate;

// Calories by goal
let calories = maintenance;
if (goal === "bulking") calories = maintenance * cfg.gain;
else if (goal === "cutting") calories = maintenance * cfg.cut;
else if (goal === "endurance") calories = maintenance * 1.02;
else if (goal === "general") calories = maintenance;

// Macros (goal-aware)
let proteinMultiplier = cfg.pro;
let fatMultiplier = cfg.fat;

// small macro tweaks for endurance/general
if (goal === "endurance") {
proteinMultiplier = Math.max(1.8, proteinMultiplier - 0.2);
fatMultiplier = Math.max(0.7, fatMultiplier - 0.1);
}
// keep protein solid on cutting
if (goal === "cutting") proteinMultiplier = Math.max(proteinMultiplier, 2.2);

let protein = w * proteinMultiplier;
let fat = w * fatMultiplier;

let proteinCal = protein * 4;
let fatCal = fat * 9;

let carbCal = calories - (proteinCal + fatCal);
if (carbCal < 0) carbCal = 0;
let carbs = carbCal / 4;

document.getElementById('res-cal').innerText = Math.round(calories);
document.getElementById('res-pro').innerText = Math.round(protein);
document.getElementById('res-fat').innerText = Math.round(fat);
document.getElementById('res-carb').innerText = Math.round(carbs);

// Workout plans (HOME vs GYM) with Experience
const homePlans = {
beginner: [
["Monday", "Full Body (Home)", [
["Push", "Incline/Regular Push-ups 3x8-12"],
["Pull", "Assisted Pull-ups or DB Rows 3x6-10"],
["Legs", "Bodyweight Squats 3x12-15"],
["Core", "Plank 3x30-45s"]
]],
["Wednesday", "Upper (Home)", [
["Chest", "Push-ups 4x8-12"],
["Back", "Pull-ups/Negatives 4x4-8"],
["Arms", "Dumbbell Curls 3x10-12"],
["Core", "Leg Raises 3x10-12"]
]],
["Friday", "Lower (Home)", [
["Legs", "Lunges 3x10/leg"],
["Glutes", "Hip Thrusts 3x12-15"],
["Calves", "Calf Raises 4x15-20"],
["Conditioning", "Jumping Jacks 6x30s"]
]]
],
intermediate: [
["Monday", "Push (Home)", [
["Chest", "Decline Push-ups 4x10-15"],
["Shoulders", "Pike Push-ups 4x6-10"],
["Triceps", "Chair Dips 4x10-15"],
["Core", "Plank Variations 3x45-60s"]
]],
["Wednesday", "Pull (Home)", [
["Back", "Pull-ups 5x4-10"],
["Back", "One-arm DB Rows 4x8-12"],
["Biceps", "DB Curls 4x10-12"],
["Rear Delts", "Reverse Fly (DB) 3x12-15"]
]],
["Friday", "Legs + Conditioning (Home)", [
["Legs", "Bulgarian Split Squats 4x8-12"],
["Hamstrings", "RDL (DB) 4x8-12"],
["Calves", "Calf Raises 4x15-20"],
["Conditioning", "Burpees 6x10"]
]]
],
expert: [
["Monday", "Upper Strength (Home)", [
["Chest", "Weighted Push-ups 5x6-10"],
["Back", "Pull-ups 6x4-10"],
["Shoulders", "Handstand/Pike Push-ups 5x4-8"],
["Core", "Hanging Leg Raises 4x8-12"]
]],
["Wednesday", "Lower Strength (Home)", [
["Legs", "Pistol Squat Progression 5x4-8"],
["Hamstrings", "Single-leg RDL (DB) 5x6-10"],
["Glutes", "Hip Thrusts 4x10-15"],
["Conditioning", "HIIT 10-15 min"]
]],
["Friday", "Hypertrophy (Home)", [
["Full Body", "Circuit 4 rounds (push/pull/legs/core)"],
["Arms", "Superset curls + dips 4x12"],
["Core", "Rollouts / Ab wheel 4x8-12"]
]]
]
};

const gymPlans = {
beginner: [
["Monday", "Full Body (Gym)", [
["Legs", "Leg Press 3x10-12"],
["Push", "Machine Chest Press 3x8-12"],
["Pull", "Lat Pulldown 3x8-12"],
["Core", "Cable Crunch 3x12-15"]
]],
["Wednesday", "Upper (Gym)", [
["Chest", "Incline DB Press 3x8-12"],
["Back", "Seated Cable Row 3x8-12"],
["Shoulders", "DB Lateral Raise 3x12-15"],
["Arms", "Triceps Pushdown 3x10-12"]
]],
["Friday", "Lower (Gym)", [
["Legs", "Smith Squat 3x8-12"],
["Hamstrings", "Leg Curl 3x10-12"],
["Calves", "Calf Raise Machine 4x12-20"],
["Conditioning", "Treadmill 10-15 min"]
]]
],
intermediate: [
["Monday", "Push (Gym)", [
["Chest", "Bench Press or DB Press 4x6-10"],
["Shoulders", "Machine Shoulder Press 4x8-12"],
["Chest", "Cable Fly 3x12-15"],
["Triceps", "Rope Pushdown 4x10-12"]
]],
["Wednesday", "Pull (Gym)", [
["Back", "Lat Pulldown 4x8-12"],
["Back", "Chest Supported Row 4x8-12"],
["Back", "Seated Cable Row 3x10-12"],
["Biceps", "EZ Bar Curl 4x10-12"]
]],
["Friday", "Legs (Gym)", [
["Legs", "Squat or Hack Squat 4x6-10"],
["Hamstrings", "RDL 4x6-10"],
["Legs", "Leg Extension 3x12-15"],
["Calves", "Standing Calf Raise 4x12-20"]
]]
],
expert: [
["Monday", "Push Power (Gym)", [
["Chest", "Bench Press 5x3-6"],
["Shoulders", "Overhead Press 5x3-6"],
["Chest", "Incline DB Press 4x6-10"],
["Triceps", "Skullcrushers 4x8-12"]
]],
["Wednesday", "Pull Power (Gym)", [
["Back", "Deadlift 5x2-5"],
["Back", "Weighted Pull-ups 5x4-8"],
["Back", "Barbell Row 4x6-10"],
["Biceps", "Incline DB Curl 4x10-12"]
]],
["Friday", "Legs Power (Gym)", [
["Legs", "Squat 5x3-6"],
["Hamstrings", "RDL 4x6-10"],
["Legs", "Leg Press 4x10-15"],
["Conditioning", "Stairmaster 10-15 min"]
]]
]
};

const plan = (workoutType === "gym" ? gymPlans : homePlans)[exp];

document.getElementById('plan-type').innerText =
(workoutType === "gym" ? "Gym Workout" : "Home Workout") + " • " +
exp.charAt(0).toUpperCase() + exp.slice(1) + " • " +
(goal === "general" ? "General Fitness" : goal.charAt(0).toUpperCase() + goal.slice(1));

let workoutHTML = "";
plan.forEach(([day, title, blocks]) => {
workoutHTML += `<div class="workout-day">
<strong>${day} (${title})</strong><br>`;
blocks.forEach(([group, text]) => {
workoutHTML += `<span class="muscle-group">${group}:</span> ${text}<br>`;
});
workoutHTML += `</div>`;
});

document.getElementById('workout-list').innerHTML = workoutHTML;
document.getElementById('result').style.display = 'block';
}
</script>

</body>
</html>
